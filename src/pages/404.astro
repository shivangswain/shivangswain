---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---

<Base title={`Page not found | ${site.name}`} description="404: page not found." noindex>
	<Header home={false} />
	<main id="main" class="not-found">
		<p class="eyebrow"><span class="eyebrow-num">404</span>Page not found</p>
		<h1 class="not-found-title">Off <em class="accent">track</em></h1>
		<p class="lede">
			This page doesn't exist, or it's been moved. Box, box: head back to the pits and try again.
		</p>
		<a class="btn btn-neon" href="/">Back home<Icon name="arrowRight" /></a>
	</main>
	<Footer />
</Base>
