---
import Logo from "./Logo.astro";

/**
 * Monochrome redraw of the CompTIA Security+ ce badge (as issued on Credly),
 * used as a translucent watermark. Everything paints in `currentColor`; text
 * uses textLength so it keeps the badge's proportions in any font.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;

// The outer ring is open at the bottom: an arc from 134° round the top to 46°.
const ring = { r: 258.5, width: 23 };
const point = (deg: number) => {
	const rad = (deg * Math.PI) / 180;
	return `${(300 + ring.r * Math.cos(rad)).toFixed(1)} ${(300 + ring.r * Math.sin(rad)).toFixed(1)}`;
};
const arc = `M${point(134)}A${ring.r} ${ring.r} 0 1 1 ${point(46)}`;
---

<svg
	class:list={["badge", className]}
	viewBox="0 0 600 600"
	fill="currentColor"
	aria-hidden="true"
	focusable="false"
>
	<path d={arc} fill="none" stroke="currentColor" stroke-width={ring.width}></path>
	<circle cx="300" cy="300" r="240" fill="none" stroke="currentColor" stroke-width="4"></circle>
	<Logo name="comptia" decorative x={153} y={147} width={294} height={63} />
	<text
		x="300"
		y="316"
		text-anchor="middle"
		font-size="76"
		font-weight="750"
		textLength="352"
		lengthAdjust="spacingAndGlyphs">Security+</text
	>
	<rect x="186" y="364" width="228" height="51" rx="25.5" fill="none" stroke="currentColor" stroke-width="5"
	></rect>
	<text
		x="300"
		y="402"
		text-anchor="middle"
		font-size="34"
		font-weight="650"
		textLength="180"
		lengthAdjust="spacingAndGlyphs">CERTIFIED</text
	>
	<text
		x="300"
		y="482"
		text-anchor="middle"
		font-size="38"
		font-weight="600"
		textLength="211"
		lengthAdjust="spacingAndGlyphs">Plus Series</text
	>
</svg>
