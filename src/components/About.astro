---
import { facts, summary } from "../data/site";
---

<section class="section about" id="about" aria-labelledby="about-title">
	<p class="eyebrow reveal"><span class="eyebrow-num">01</span>About</p>
	<h2 class="manifesto reveal" id="about-title">
		Threat-modelling <em class="accent">systems</em>, building <em class="accent">guardrails</em> and
		enabling <em class="accent">secure AI</em> across cloud, containers &amp; LLMs.
	</h2>

	<div class="about-grid">
		<p class="lede reveal">{summary}</p>
		<dl class="facts">
			{
				facts.map((fact) => (
					<div class="fact reveal">
						<dt>{fact.label}</dt>
						<dd>{fact.value}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
