---
import Icon from "./Icon.astro";
import { site } from "../data/site";

// Each letter is its own span for the staggered entrance and the cursor weight
// effect. They're hidden from assistive tech; the heading's real text is the
// sr-only span. On hover devices "P SWAIN" waits behind "SHIVANG" and drops
// down when the name is hovered (CSS only, see .hero-line-last).
const letters = (word: string) => [...word];
---

<section class="hero" id="top" aria-labelledby="hero-title">
	<div class="hero-meta">
		<p class="status">
			<span class="pulse" aria-hidden="true"></span>
			{site.role}<span class="status-sep" aria-hidden="true">/</span>{site.focus}<span
				class="status-sep"
				aria-hidden="true">/</span
			>{site.company}
		</p>
		<p class="clock">Bengaluru <time data-clock>--:--</time> IST</p>
	</div>

	<h1 class="hero-title" id="hero-title">
		<span class="sr-only">Hi, I'm {site.name}.</span>
		<span class="hero-hi" aria-hidden="true">Hi, I'm</span>
		<span class="hero-line" aria-hidden="true">
			{letters(site.firstName).map((ch) => <span class="ch">{ch}</span>)}
		</span>
		<span class="hero-line hero-line-last" aria-hidden="true">
			<span class="hero-line-inner">
				{letters(site.lastName).map((ch) => (ch === " " ? <span class="ch-gap" /> : <span class="ch">{ch}</span>))}
			</span>
		</span>
	</h1>

	<div class="hero-foot">
		<p class="hero-intro">
			I'm a hands-on security architect with 4+ years in AI and cloud security: identifying
			<em class="accent">threats</em>, creating <em class="accent">controls</em>, securing
			<em class="accent">platforms</em> and building the <em class="accent">guardrails</em> that take
			AI-first and cloud-native teams to production safely and securely.
		</p>
		<div class="hero-actions">
			<a class="btn btn-neon" href="#contact">Get in touch<Icon name="arrowRight" /></a>
		</div>
	</div>
</section>
