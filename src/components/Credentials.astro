---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import SectionHead from "./SectionHead.astro";
import { credentials } from "../data/site";
---

<section class="section credentials" aria-labelledby="credentials-title">
	<SectionHead num="05" eyebrow="Education & certifications" id="credentials-title">
		On <em class="accent">paper</em>
	</SectionHead>

	<div class="cred-grid">
		{credentials.map((cred) => (
			<article class="cred reveal">
				<span class:list={["cred-mark", `cred-mark-${cred.mark}`]} aria-hidden="true" />
				<p class="cred-kind">{cred.kind}</p>
				<h3 class="cred-title">{cred.title}</h3>
				<p class="cred-org">
					{cred.org === "CompTIA" ? <Logo name="comptia" class="cred-logo" /> : cred.org}
				</p>
				<p class="cred-meta">{cred.meta}</p>
				<a class="link-arrow" href={cred.href} target="_blank" rel="noopener">
					{cred.cta}
					<Icon name="arrowUpRight" />
				</a>
			</article>
		))}
	</div>
</section>
