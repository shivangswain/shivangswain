---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { nav } from "../data/site";

interface Props {
	/** Off the home page, section links need to point back at it. */
	home?: boolean;
}

const { home = true } = Astro.props;
const base = home ? "" : "/";
---

<header class="site-header">
	<a class="wordmark" href={home ? "#top" : "/"} aria-label="Shivang P Swain, back to top">
		<span class="wordmark-first">Shivang</span>
		<span class="wordmark-last">P Swain</span>
	</a>

	<nav class="site-nav" aria-label="Sections">
		<ul>
			{
				nav.map((item) => (
					<li>
						<a href={base + item.href}>{item.label}</a>
					</li>
				))
			}
		</ul>
	</nav>

	<div class="header-actions">
		<a class="btn btn-neon btn-sm" href="/resume" target="_blank" rel="noopener">
			Résumé<Icon name="arrowUpRight" />
		</a>
		<ThemeToggle />
	</div>
</header>
