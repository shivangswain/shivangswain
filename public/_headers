# Cloudflare Pages headers. Every matching rule applies, so the catch-all at
# the bottom only sets headers the path-specific rules above don't.

# Fingerprinted build output (fonts, any bundled assets): safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static files under stable names (icons, résumé, degree, OG image) can change
# in place, so cache for a day and revalidate.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate
/favicon.*
  Cache-Control: public, max-age=86400, must-revalidate
/site.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate

# HTML: always revalidate so visitors get the latest build (304s keep it cheap).
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Security headers for everything. The main Content-Security-Policy (with
# hashes for every inline script and style) is generated by Astro into each
# page's <meta>; this header adds the directives a <meta> policy can't carry.
# Browsers enforce both policies together.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self' mailto:; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
