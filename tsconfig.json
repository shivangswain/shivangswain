{
  // Type-check only; Node strips the types when running and building.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,

    /* Syntax Node's type stripping supports */
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "build.ts", "subset-font.d.ts"]
}
